SITE_DOMAIN=cond.example.com
ACME_EMAIL=owner@example.com
POSTGRES_OWNER_PASSWORD=replace-with-a-unique-long-owner-password
DB_PASSWORD=replace-with-a-different-long-app-password
SECRET_KEY=replace-with-at-least-48-random-characters-generated-for-this-server
SUPERADMIN_EMAILS=owner@example.com
SUPERADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters
