# Telegram group: owner + administrator. Keep the token only on the server.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_REMINDER_HOURS=9,17
